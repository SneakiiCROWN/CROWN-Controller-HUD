<Application x:Class="CrownControllerHUD.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CrownControllerHUD"
             xmlns:converters="clr-namespace:CrownControllerHUD.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:ControllerTypeToDisplayNameConverter x:Key="ControllerTypeToDisplayNameConverter"/>
            <converters:ControllerTypeToIconConverter x:Key="ControllerTypeToIconConverter"/>
            <converters:ConnectionToColorConverter x:Key="ConnectionToColorConverter"/>
            <converters:ConnectionToTextConverter x:Key="ConnectionToTextConverter"/>
            <converters:ConnectionToIndicatorColorConverter x:Key="ConnectionToIndicatorColorConverter"/>
            <converters:BatteryPercentageToColorConverter x:Key="BatteryPercentageToColorConverter"/>
            <converters:DictionaryToStringConverter x:Key="DictionaryToStringConverter"/>
            <converters:VidPidMultiConverter x:Key="MultiBindingConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <converters:BatteryStateToColorConverter x:Key="BatteryStateToColorConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>