<Window x:Class="CrownControllerHUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrownControllerHUD"
        xmlns:vm="clr-namespace:CrownControllerHUD.ViewModels"
        xmlns:models="clr-namespace:CrownControllerHUD.Models"
        mc:Ignorable="d"
        Title="CROWN Controller HUD"
        Height="700" Width="1000"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        Foreground="#FFFFFF"
        FontFamily="Oxanium, Segoe UI, sans-serif"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <DataTemplate DataType="{x:Type models:ControllerType}">
                <TextBlock Text="{Binding Converter={StaticResource ControllerTypeToDisplayNameConverter}}"/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1F1F1F" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo/Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CROWN" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="CROWN Controller HUD" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Oxanium"/>
                        <TextBlock Text="Professional Gaming Controller Companion" FontSize="11" Foreground="#888888" FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Ellipse x:Name="StatusIndicator" Width="10" Height="10" Fill="#4CAF50" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            Padding="16,8" FontSize="12" ToolTip="Refresh controller detection"/>
                    <Button Content="Test Notification" Command="{Binding TestNotificationCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                            Padding="16,8" FontSize="12" ToolTip="Send a test notification to verify notification system"/>
                    <Button Content="Diagnostics" Command="{Binding ShowDiagnosticsCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            Padding="16,8" FontSize="12" ToolTip="Show provider diagnostics and errors"/>
                    <Button Content="? Settings" Command="{Binding SettingsCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            Padding="16,8" FontSize="12"/>
                    <Button Content="? Minimize to Tray" Command="{Binding MinimizeToTrayCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,8" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" MinWidth="360" MaxWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- Controller List -->
            <Border Grid.Column="0" Background="#1F1F1F" BorderBrush="#333333" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252525" BorderBrush="#333333" BorderThickness="0,0,0,1" 
                            CornerRadius="8,8,0,0" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Detected Controllers" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock Grid.Column="1" Text="{Binding ConnectedCount, StringFormat='{}{0} connected'}" 
                                       FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" x:Name="ControllerList" 
                              ItemsSource="{Binding Controllers}" 
                              SelectedItem="{Binding SelectedController, Mode=TwoWay}"
                              Background="Transparent" BorderThickness="0"
                              Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="4,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="#333333"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2A2A2A"/>
                                        <Setter Property="BorderBrush" Value="#0078D4"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#252525"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ControllerViewModel}">
                                <Border Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Controller Icon -->
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" 
                                                Background="#2A2A2A" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Info.Type, Converter={StaticResource ControllerTypeToIconConverter}}" 
                                                       FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Controller Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" Foreground="#FFFFFF"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding ConnectionType}" FontSize="11" Foreground="#888888"/>
                                                <TextBlock Text=" | " FontSize="11" Foreground="#555555"/>
                                                <TextBlock Text="{Binding BatteryText}" FontSize="11" FontWeight="Medium" 
                                                           Foreground="{Binding Info.BatteryPercentage, Converter={StaticResource BatteryPercentageToColorConverter}}"/>
                                                <TextBlock Text=" | " FontSize="11" Foreground="#555555" 
                                                           Visibility="{Binding IsCharging, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="⚡ Charging" FontSize="11" FontWeight="Medium" Foreground="#FFD700"
                                                           Visibility="{Binding IsCharging, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                                            <Border Background="{Binding IsConnected, Converter={StaticResource ConnectionToColorConverter}}" 
                                                    CornerRadius="10" Padding="8,4" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding IsConnected, Converter={StaticResource ConnectionToTextConverter}}" 
                                                           FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                            <Ellipse Width="10" Height="10" Fill="{Binding IsConnected, Converter={StaticResource ConnectionToIndicatorColorConverter}}" 
                                                     VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty State -->
                    <Border Grid.Row="1" Background="Transparent" Visibility="{Binding Controllers.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="○" FontSize="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="No controllers detected" FontSize="16" Foreground="#888888" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                            <TextBlock Text="Connect a controller via USB, Bluetooth, or Xbox Wireless Adapter" 
                                       FontSize="12" Foreground="#666666" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="300"/>
                            <Button Content="Scan Again" Command="{Binding RefreshCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,24,0,0" Padding="24,10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Controller Details Panel -->
            <Border Grid.Column="1" Background="#1F1F1F" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Margin="12,0,0,0"
                    Visibility="{Binding SelectedController, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Controller Header -->
                    <Border Grid.Row="0" Background="#252525" BorderBrush="#333333" BorderThickness="0,0,0,1" 
                            CornerRadius="8,8,0,0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="10" Background="#2A2A2A">
                                <TextBlock Text="{Binding SelectedController.Info.Type, Converter={StaticResource ControllerTypeToIconConverter}}" 
                                           FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedController.Name}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding SelectedController.ConnectionType}" FontSize="12" Foreground="#888888"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Details -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <!-- Battery Section -->
                            <Border Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="BATTERY" FontSize="11" FontWeight="Bold" 
                                               Foreground="#888888" Margin="0,0,0,12"/>

                                    <!-- Battery Visual -->
                                    <Border Grid.Row="1" Grid.Column="0" Width="120" Height="48" CornerRadius="6" 
                                            BorderBrush="#444444" BorderThickness="2" Background="#151515" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="BatteryFill" Background="#4CAF50" CornerRadius="4,0,0,4" Margin="2"
                                                    HorizontalAlignment="Left" Width="0"/>
                                            <Border Grid.Column="1" Width="4" Background="#444444" HorizontalAlignment="Right" Margin="0,8"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedController.BatteryText}" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Oxanium"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding SelectedController.BatteryStateText}" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text=" • " FontSize="11" Foreground="#555555" Visibility="{Binding SelectedController.IsCharging, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="? Charging" FontSize="11" FontWeight="Medium" Foreground="#FFD700"
                                                       Visibility="{Binding SelectedController.IsCharging, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Connection Details -->
                            <Border Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CONNECTION" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:" FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedController.Info.Type, Converter={StaticResource ControllerTypeToDisplayNameConverter}}" FontSize="12" Foreground="#FFFFFF" Margin="0,4"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Interface:" FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedController.ConnectionType}" FontSize="12" Foreground="#FFFFFF" Margin="0,4"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="VID/PID:" FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedController.Info.VendorId, StringFormat='VID: {0:X4}'}" FontSize="12" Foreground="#FFFFFF" Margin="0,4"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Connected:" FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedController.Info.ConnectedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}" FontSize="12" Foreground="#FFFFFF" Margin="0,4"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Hardware Details -->
                            <Border Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="HARDWARE" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer:" FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedController.Info.Manufacturer, FallbackValue=Unknown}" FontSize="12" Foreground="#FFFFFF" Margin="0,4"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Firmware:" FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedController.FirmwareVersion}" FontSize="12" Foreground="#FFFFFF" Margin="0,4"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Serial:" FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedController.Info.SerialNumber, FallbackValue=Unknown}" FontSize="12" Foreground="#FFFFFF" Margin="0,4"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="HW Revision:" FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedController.Info.HardwareRevision, FallbackValue=Unknown}" FontSize="12" Foreground="#FFFFFF" Margin="0,4"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Capabilities:" FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
                                        <WrapPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                            <Border Background="#0078D4" CornerRadius="4" Padding="4,2" Margin="2" Visibility="{Binding SelectedController.Info.SupportsVibration, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Vibration" FontSize="10" Foreground="#FFFFFF"/>
                                            </Border>
                                            <Border Background="#0078D4" CornerRadius="4" Padding="4,2" Margin="2" Visibility="{Binding SelectedController.Info.SupportsAudio, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Audio" FontSize="10" Foreground="#FFFFFF"/>
                                            </Border>
                                            <Border Background="#0078D4" CornerRadius="4" Padding="4,2" Margin="2" Visibility="{Binding SelectedController.Info.SupportsBatteryReporting, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Battery Reporting" FontSize="10" Foreground="#FFFFFF"/>
                                            </Border>
                                            <Border Background="#0078D4" CornerRadius="4" Padding="4,2" Margin="2" Visibility="{Binding SelectedController.Info.SupportsChargingStatus, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Charging Status" FontSize="10" Foreground="#FFFFFF"/>
                                            </Border>
                                            <Border Background="#0078D4" CornerRadius="4" Padding="4,2" Margin="2" Visibility="{Binding SelectedController.Info.SupportsWireless, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Wireless" FontSize="10" Foreground="#FFFFFF"/>
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Raw Data (Debug) -->
                            <Expander Header="RAW DEVICE DATA" Foreground="#666666" FontSize="11" FontWeight="Bold" Margin="0,0,0,12">
                                <Border Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <ScrollViewer MaxHeight="200">
                                        <TextBlock x:Name="RawDataText" FontFamily="Consolas, monospace" FontSize="10" Foreground="#888888" 
                                                   Text="{Binding SelectedController.Info.RawProperties, Converter={StaticResource DictionaryToStringConverter}}"
                                                   TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Actions -->
                    <Border Grid.Row="2" Background="#252525" BorderBrush="#333333" BorderThickness="0,1,0,0" 
                            CornerRadius="0,0,8,8" Padding="16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Copy Device ID" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6"
                                    Command="{Binding CopyDeviceIdCommand}" CommandParameter="{Binding SelectedController.DeviceId}"/>
                            <Button Content="Force Refresh" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- No Selection Placeholder -->
            <Border Grid.Column="1" Background="#1F1F1F" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Margin="12,0,0,0"
                    Visibility="{Binding SelectedController, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="○" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a controller" FontSize="16" Foreground="#888888" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                    <TextBlock Text="Click a controller from the list to view detailed information" 
                               FontSize="12" Foreground="#666666" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="280"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="#151515" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="FooterText" Text="Ready" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="WinRT:" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Ellipse x:Name="WinRTStatus" Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="HID:" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Ellipse x:Name="HIDStatus" Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="BLE:" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Ellipse x:Name="BLEStatus" Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="v1.0.0" FontSize="11" Foreground="#555555" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Diagnostics Panel (Collapsible) -->
        <Expander Grid.Row="3" Header="DIAGNOSTICS &amp; PROVIDER STATUS" Foreground="#666666" FontSize="11" FontWeight="Bold" 
                  IsExpanded="{Binding ShowDiagnostics}" Background="#151515" BorderBrush="#333333" BorderThickness="0,1,0,0"
                  Margin="0,8,0,0" Padding="0">
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="PROVIDER STATUS" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding ProviderDiagnostics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text="{Binding ErrorMessage}" FontSize="10" Foreground="#F44336" TextWrapping="Wrap" 
                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DeviceCount, StringFormat='{}{0} devices'}" 
                                                   FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <Separator Margin="0,16,0,8" Background="#333333"/>
                    
                    <TextBlock Text="SYSTEM INFO" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,8"/>
                    <StackPanel>
                        <TextBlock Text="{Binding SystemInfo}" FontSize="10" FontFamily="Consolas, monospace" Foreground="#888888" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <Separator Margin="0,16,0,8" Background="#333333"/>
                    
                    <TextBlock Text="RECENT LOG ENTRIES" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,8"/>
                    <Button Content="Open Diagnostic Log" Command="{Binding OpenLogCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Padding="16,8"/>
                    <Button Content="Copy Diagnostics to Clipboard" Command="{Binding CopyDiagnosticsCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="16,8"/>
                </StackPanel>
            </ScrollViewer>
        </Expander>

        <!-- System Tray icon is created in code-behind (see MainWindow.SetupTrayIcon).
             It is intentionally NOT declared here: a tray/icon failure while parsing XAML
             would abort window creation and leave the app running with no visible UI. -->
    </Grid>
</Window>





