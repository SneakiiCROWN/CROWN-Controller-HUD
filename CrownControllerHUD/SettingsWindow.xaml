<Window x:Class="CrownControllerHUD.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CROWN Settings"
        Height="600" Width="800"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1A"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI, sans-serif">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Category List -->
        <Border Grid.Column="0" Background="#1F1F1F" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <StackPanel Margin="8">
                <TextBlock Text="SETTINGS" FontSize="16" FontWeight="Bold" Foreground="#0078D4" Margin="8,12,8,16"/>
                <Button Content="General" Style="{StaticResource SecondaryButtonStyle}" 
                        Margin="0,2" Padding="12,8" HorizontalAlignment="Stretch" 
                        Click="General_Click" HorizontalContentAlignment="Left"/>
                <Button Content="Notifications" Style="{StaticResource SecondaryButtonStyle}" 
                        Margin="0,2" Padding="12,8" HorizontalAlignment="Stretch" 
                        Click="Notifications_Click" HorizontalContentAlignment="Left"/>
                <Button Content="Battery" Style="{StaticResource SecondaryButtonStyle}" 
                        Margin="0,2" Padding="12,8" HorizontalAlignment="Stretch" 
                        Click="Battery_Click" HorizontalContentAlignment="Left"/>
                <Button Content="Appearance" Style="{StaticResource SecondaryButtonStyle}" 
                        Margin="0,2" Padding="12,8" HorizontalAlignment="Stretch" 
                        Click="Appearance_Click" HorizontalContentAlignment="Left"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel x:Name="ContentPanel">
                <!-- General Settings -->
                <StackPanel x:Name="GeneralPanel">
                    <TextBlock Text="General" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>
                    
                    <CheckBox x:Name="StartWithWindows" Content="Start with Windows" 
                              Foreground="#CCCCCC" Margin="0,8" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed"/>
                    <TextBlock Text="Start CROWN automatically when you sign in to Windows." 
                               FontSize="11" Foreground="#888888" Margin="20,0,0,8"/>
                    
                    <CheckBox x:Name="StartHidden" Content="Start hidden (minimised to tray)" 
                              Foreground="#CCCCCC" Margin="0,8"/>
                    <TextBlock Text="Don't show the dashboard on startup." 
                               FontSize="11" Foreground="#888888" Margin="20,0,0,8"/>
                    
                    <CheckBox x:Name="MinimizeToTray" Content="Minimise to tray" 
                              Foreground="#CCCCCC" Margin="0,8"/>
                    <TextBlock Text="Minimise the dashboard to the system tray instead of the taskbar." 
                               FontSize="11" Foreground="#888888" Margin="20,0,0,8"/>
                    
                    <CheckBox x:Name="CloseToTray" Content="Close to tray" 
                              Foreground="#CCCCCC" Margin="0,8"/>
                    <TextBlock Text="Closing the dashboard keeps CROWN running in the background." 
                               FontSize="11" Foreground="#888888" Margin="20,0,0,8"/>
                    
                    <CheckBox x:Name="ShowDisconnected" Content="Show disconnected controllers" 
                              Foreground="#CCCCCC" Margin="0,8"/>
                    <TextBlock Text="Display controllers even when they're powered off." 
                               FontSize="11" Foreground="#888888" Margin="20,0,0,8"/>
                    
                    <Button Content="Reset to Defaults" Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Left"
                            Click="ResetDefaults_Click"/>
                </StackPanel>

                <!-- Notifications Settings -->
                <StackPanel x:Name="NotificationsPanel" Visibility="Collapsed">
                    <TextBlock Text="Notifications" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>
                    
                    <CheckBox x:Name="EnableNotifications" Content="Enable notifications" 
                              Foreground="#CCCCCC" Margin="0,8" Checked="EnableNotifications_Changed" Unchecked="EnableNotifications_Changed"/>
                    
                    <TextBlock Text="Notification Types" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,12,0,8"/>
                    
                    <CheckBox x:Name="NotifyOnConnect" Content="Controller connected" Foreground="#CCCCCC" Margin="20,4"/>
                    <CheckBox x:Name="NotifyOnDisconnect" Content="Controller disconnected" Foreground="#CCCCCC" Margin="20,4"/>
                    <CheckBox x:Name="NotifyOnLowBattery" Content="Low battery" Foreground="#CCCCCC" Margin="20,4"/>
                    <CheckBox x:Name="NotifyOnCriticalBattery" Content="Critical battery" Foreground="#CCCCCC" Margin="20,4"/>
                    <CheckBox x:Name="NotifyOnCharging" Content="Charging started" Foreground="#CCCCCC" Margin="20,4"/>
                    <CheckBox x:Name="NotifyOnFullCharge" Content="Fully charged" Foreground="#CCCCCC" Margin="20,4"/>
                    
                    <TextBlock Text="Notification Duration" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,12,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <Slider x:Name="NotificationDuration" Minimum="1500" Maximum="30000" Width="200" 
                                ValueChanged="NotificationDuration_Changed"/>
                        <TextBlock x:Name="DurationText" Text="5000 ms" FontSize="12" Foreground="#CCCCCC" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="Sound" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,12,0,8"/>
                    <CheckBox x:Name="PlaySound" Content="Play notification sound" Foreground="#CCCCCC" Margin="0,4"/>
                    
                    <TextBlock Text="Position" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,12,0,8"/>
                    <ComboBox x:Name="NotificationPosition" Width="200" Margin="0,4">
                        <ComboBoxItem Content="Bottom Right"/>
                        <ComboBoxItem Content="Bottom Left"/>
                        <ComboBoxItem Content="Top Right"/>
                        <ComboBoxItem Content="Top Left"/>
                    </ComboBox>
                    
                    <Button Content="Test Notification" Style="{StaticResource PrimaryButtonStyle}" 
                            Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Left"
                            Click="TestNotification_Click"/>
                </StackPanel>

                <!-- Battery Settings -->
                <StackPanel x:Name="BatteryPanel" Visibility="Collapsed">
                    <TextBlock Text="Battery" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>
                    
                    <CheckBox x:Name="EnableBatteryTelemetry" Content="Enable battery telemetry" 
                              Foreground="#CCCCCC" Margin="0,8"/>
                    <TextBlock Text="Read genuine battery levels from supported sources." 
                               FontSize="11" Foreground="#888888" Margin="20,0,0,8"/>
                    
                    <TextBlock Text="Warning Thresholds" FontSize="13" FontWeight="SemiBold" Foreground="#AAAAAA" Margin="0,12,0,8"/>
                    <TextBlock Text="Warnings fire when battery drops below these levels. Each level warns once per discharge." 
                               FontSize="11" Foreground="#888888" Margin="0,0,0,8"/>
                    
                    <CheckBox x:Name="Warn50" Content="50%" Foreground="#CCCCCC" Margin="20,4"/>
                    <CheckBox x:Name="Warn20" Content="20%" Foreground="#CCCCCC" Margin="20,4"/>
                    <CheckBox x:Name="Warn15" Content="15%" Foreground="#CCCCCC" Margin="20,4"/>
                    <CheckBox x:Name="Warn10" Content="10% (critical)" Foreground="#CCCCCC" Margin="20,4"/>
                    <CheckBox x:Name="Warn5" Content="5% (critical)" Foreground="#CCCCCC" Margin="20,4"/>
                    
                    <TextBlock Text="Battery telemetry is read only from genuine sources (Windows.Gaming.Input, Bluetooth GATT 0x180F, XInput). 
No values are fabricated. Missing data shows as Unknown, never 0%." 
                               FontSize="11" Foreground="#888888" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Appearance Settings -->
                <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                    <TextBlock Text="Appearance" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>
                    <TextBlock Text="Theme and accent colour customisation coming in a future update." 
                               FontSize="12" Foreground="#888888" Margin="0,8"/>
                    <TextBlock Text="Default: CROWN Dark (premium dark theme)" 
                               FontSize="12" Foreground="#CCCCCC" Margin="0,4"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
