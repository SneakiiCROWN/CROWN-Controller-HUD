<Window x:Class="CrownControllerHUD.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="180" Width="400"
        MinHeight="160" MinWidth="350"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI, sans-serif"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Message}" FontSize="13" Foreground="#CCCCCC" 
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBox Grid.Row="1" x:Name="InputTextBox" 
                 Text="{Binding ResponseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="13" Padding="10,8"
                 Background="#1F1F1F" BorderBrush="#333333" BorderThickness="1"
                 Foreground="#FFFFFF" CaretBrush="#0078D4"
                 Margin="0,0,0,16"
                 KeyDown="InputTextBox_KeyDown"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" 
                    Padding="16,6" Margin="0,0,8,0" IsCancel="True"
                    Click="Cancel_Click"/>
            <Button Content="OK" Style="{StaticResource PrimaryButtonStyle}" 
                    Padding="16,6" IsDefault="True"
                    Click="OK_Click"/>
        </StackPanel>
    </Grid>
</Window>