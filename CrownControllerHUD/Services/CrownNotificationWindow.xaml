<Window x:Class="CrownControllerHUD.Services.CrownNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CROWN Controller HUD"
        Width="384"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">

    <!-- Outer margin leaves room for the drop shadow. -->
    <Grid x:Name="Root" Margin="16" RenderTransformOrigin="1,1">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Border x:Name="Card" CornerRadius="12" BorderThickness="1" BorderBrush="#2BFFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F50C1016" Offset="0" />
                    <GradientStop Color="#F5171D27" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.62" Color="#FF000000" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Accent bar: colour identifies the event kind at a glance. -->
                <Border x:Name="AccentBar" Grid.Column="0" Width="4" CornerRadius="12,0,0,12" />

                <Grid Grid.Column="1" Margin="14,12,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: status icon, title, brand stamp, timestamp -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="IconBadge" Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                VerticalAlignment="Top" Background="#1FFFFFFF">
                            <Viewbox Width="19" Height="19">
                                <Path x:Name="IconPath" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" StrokeThickness="2" />
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#FFF3F7FC" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SubtitleText" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#FF7B8798" Margin="0,2,0,0"
                                       Text="CROWN CONTROLLER HUD" />
                        </StackPanel>

                        <TextBlock x:Name="TimeText" Grid.Column="2" FontSize="10.5"
                                   Foreground="#FF6B7789" VerticalAlignment="Top" Margin="0,3,0,0" />
                    </Grid>

                    <!-- Body -->
                    <StackPanel Grid.Row="1" Margin="47,9,0,0">
                        <TextBlock x:Name="MessageText" FontSize="12.5" Foreground="#FFC7D1DE"
                                   TextWrapping="Wrap" LineHeight="17" />
                        <TextBlock x:Name="DetailText" FontSize="11" Foreground="#FF8894A6"
                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Auto-dismiss countdown -->
                    <Grid Grid.Row="2" Margin="47,11,0,2" Height="3" ClipToBounds="True">
                        <Border Background="#1AFFFFFF" CornerRadius="1.5" />
                        <Border x:Name="ProgressFill" CornerRadius="1.5" HorizontalAlignment="Stretch"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
