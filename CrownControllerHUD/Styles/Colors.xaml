<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Palette -->
    <Color x:Key="BackgroundPrimary">#1A1A1A</Color>
    <Color x:Key="BackgroundSecondary">#1F1F1F</Color>
    <Color x:Key="BackgroundTertiary">#252525</Color>
    <Color x:Key="BackgroundHover">#2A2A2A</Color>
    <Color x:Key="BackgroundPressed">#333333</Color>

    <Color x:Key="BorderPrimary">#333333</Color>
    <Color x:Key="BorderSecondary">#2D2D2D</Color>
    <Color x:Key="BorderFocus">#0078D4</Color>

    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#CCCCCC</Color>
    <Color x:Key="TextMuted">#888888</Color>
    <Color x:Key="TextDisabled">#555555</Color>

    <Color x:Key="AccentPrimary">#0078D4</Color>
    <Color x:Key="AccentPrimaryHover">#106EBE</Color>
    <Color x:Key="AccentPrimaryPressed">#005A9E</Color>
    <Color x:Key="AccentSecondary">#FFD700</Color>

    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="WarningColor">#FFB300</Color>
    <Color x:Key="ErrorColor">#F44336</Color>
    <Color x:Key="InfoColor">#2196F3</Color>

    <Color x:Key="BatteryHigh">#4CAF50</Color>
    <Color x:Key="BatteryMedium">#FFB300</Color>
    <Color x:Key="BatteryLow">#FF9800</Color>
    <Color x:Key="BatteryCritical">#F44336</Color>
    <Color x:Key="BatteryCharging">#FFD700</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimary}"/>
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondary}"/>
    <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="{StaticResource BackgroundTertiary}"/>
    <SolidColorBrush x:Key="BackgroundHoverBrush" Color="{StaticResource BackgroundHover}"/>
    <SolidColorBrush x:Key="BackgroundPressedBrush" Color="{StaticResource BackgroundPressed}"/>

    <SolidColorBrush x:Key="BorderPrimaryBrush" Color="{StaticResource BorderPrimary}"/>
    <SolidColorBrush x:Key="BorderSecondaryBrush" Color="{StaticResource BorderSecondary}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocus}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}"/>

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}"/>
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{StaticResource AccentPrimaryHover}"/>
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="{StaticResource AccentPrimaryPressed}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondary}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <SolidColorBrush x:Key="BatteryHighBrush" Color="{StaticResource BatteryHigh}"/>
    <SolidColorBrush x:Key="BatteryMediumBrush" Color="{StaticResource BatteryMedium}"/>
    <SolidColorBrush x:Key="BatteryLowBrush" Color="{StaticResource BatteryLow}"/>
    <SolidColorBrush x:Key="BatteryCriticalBrush" Color="{StaticResource BatteryCritical}"/>
    <SolidColorBrush x:Key="BatteryChargingBrush" Color="{StaticResource BatteryCharging}"/>

    <!-- Font Families -->
    <FontFamily x:Key="FontPrimary">pack://application:,,,/Assets/#Oxanium</FontFamily>
    <FontFamily x:Key="FontUI">Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Consolas, Cascadia Code, monospace</FontFamily>

    <!-- Shadows -->
    <DropShadowEffect x:Key="ShadowSmall" BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
    <DropShadowEffect x:Key="ShadowMedium" BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="Black"/>
    <DropShadowEffect x:Key="ShadowLarge" BlurRadius="32" ShadowDepth="8" Opacity="0.5" Color="Black"/>

    <!-- Corner Radius -->
    <CornerRadius x:Key="CornerRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="CornerRadiusFull">999</CornerRadius>

    <!-- Spacing -->
    <Thickness x:Key="SpacingXS">4</Thickness>
    <Thickness x:Key="SpacingSM">8</Thickness>
    <Thickness x:Key="SpacingMD">16</Thickness>
    <Thickness x:Key="SpacingLG">24</Thickness>
    <Thickness x:Key="SpacingXL">32</Thickness>
</ResourceDictionary>